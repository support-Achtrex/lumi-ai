# ── AAIA Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── AI API Keys (powers AAIA reasoning and voice) ──────────────────
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-4.3
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
MAX_TOKENS=4096

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aaia
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ── Redis (caching + session storage) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ── JWT Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=30d

# ── AutomotiveDataset.com API (Achtrex data backbone) ─────────────────────────
AUTOMOTIVE_DATASET_API_KEY=your-automotivedata set-api-key
AUTOMOTIVE_DATASET_BASE_URL=https://api.automotivedata set.com/v1
AUTOMOTIVE_DATASET_TIMEOUT=5000

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=30

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/aaia.log

# ── Email (optional — for notifications) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@achtrex.com

# ── Achtrex Branding ──────────────────────────────────────────────────────────
COMPANY_NAME=Achtrex
PRODUCT_NAME=AAIA
PRODUCT_VERSION=1.0.0
